# Copy to .env (git-ignored) and fill in. Never commit real keys.

# TypeSafe Jev classifier (langchain-typesafe). Without it, classification
# falls back to the labelled heuristic classifier.
TYPESAFE_API_KEY=
# Optional: override the TypeSafe endpoint (gateway / private deployment).
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# OpenRouter (ChatOpenRouter) for the seven OpenRouter-hosted VLMs.
OPENROUTER_API_KEY=

# Direct OpenAI API (ChatOpenAI) for gpt-5.1.
OPENAI_API_KEY=
